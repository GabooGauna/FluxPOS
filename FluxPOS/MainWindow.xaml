<Window x:Class="FluxPOS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FluxPOS"
        mc:Ignorable="d"
        Title="FluxPOS - Terminal de Ventas" Height="550" Width="1000"
        WindowStartupLocation="CenterScreen">

    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F5F7FA" Offset="0.0" />
            <GradientStop Color="#C3CFE2" Offset="1.0" />
        </LinearGradientBrush>
    </Window.Background>

    <Grid Margin="10">
        <TabControl x:Name="tcPrincipal" 
                    Background="Transparent" 
                    BorderThickness="0"
                    SelectionChanged="tcPrincipal_SelectionChanged">

            <TabItem Header="🛒 Terminal de Cobro" FontSize="14" FontWeight="SemiBold" Padding="15,6">
                <Grid Background="Transparent" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Margin="0,0,15,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="🛍️ Productos Disponibles (Doble clic para vender)" 
                                   FontSize="15" FontWeight="Bold" Foreground="#2D3436" Margin="0,0,0,5"/>

                        <Grid Grid.Row="1" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🔍 Buscar:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#57606F" Margin="0,0,8,0"/>
                            <TextBox x:Name="txtBuscar" Grid.Column="1" Height="28" VerticalContentAlignment="Center" Padding="5,0"
                                     TextChanged="txtBuscar_TextChanged"/>
                        </Grid>

                        <ListBox x:Name="lstProductos"
                                 Grid.Row="2"
                                 BorderBrush="#DFE6E9"
                                 BorderThickness="1"
                                 Background="White"
                                 MouseDoubleClick="lstProductos_MouseDoubleClick" />
                    </Grid>

                    <Border Grid.Column="1" 
                            Background="WhiteSmoke" 
                            BorderBrush="#B2BEC3" 
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="15">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="📋 Ticket de Venta Actual"
                                       FontSize="18" FontWeight="Bold"
                                       Foreground="#2D3436"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,10"/>

                            <ListBox x:Name="lstCarrito" 
                                     Grid.Row="1"
                                     BorderBrush="#DFE6E9"
                                     Background="White"
                                     Margin="0,5"/>

                            <StackPanel Grid.Row="2" Margin="0,10,0,0">
                                <Separator Background="#DFE6E9" Margin="0,0,0,10"/>
                                <TextBlock x:Name="lblTotal"
                                           Text="Total: $0.00"
                                           FontSize="26" FontWeight="ExtraBold"
                                           Foreground="#27AE60"
                                           HorizontalAlignment="Right"
                                           Margin="0,0,0,10" />

                                <Button x:Name="btnFinalizarCompra"
                                        Content="✔ FINALIZAR VENTA"
                                        Height="50"
                                        Background="#2ECC71" Foreground="White"
                                        FontSize="16" FontWeight="Black"
                                        Click="btnFinalizarCompra_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem x:Name="tiInventario" Header="⚙️ Control de Inventario" FontSize="14" FontWeight="SemiBold" Padding="15,6">
                <Grid Margin="5,15,5,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="15" Margin="0,0,15,0" BorderBrush="#DFE6E9" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="📦 Registrar Nuevo Artículo" FontSize="16" FontWeight="Bold" Foreground="#0984E3" Margin="0,0,0,15"/>

                            <TextBlock Text="Nombre del Producto:" FontWeight="SemiBold" Foreground="#2D3436" Margin="0,0,0,4"/>
                            <TextBox x:Name="txtNombre" Height="30" VerticalContentAlignment="Center" Padding="5,0" Margin="0,0,0,12"/>

                            <TextBlock Text="Precio de Venta ($):" FontWeight="SemiBold" Foreground="#2D3436" Margin="0,0,0,4"/>
                            <TextBox x:Name="txtPrecio" Height="30" VerticalContentAlignment="Center" Padding="5,0" Margin="0,0,0,12"/>

                            <TextBlock Text="Stock Inicial (Unidades):" FontWeight="SemiBold" Foreground="#2D3436" Margin="0,0,0,4"/>
                            <TextBox x:Name="txtStock" Height="30" VerticalContentAlignment="Center" Padding="5,0" Margin="0,0,0,20"/>

                            <Button Content="✚ Agregar al Catálogo"
                                    Height="40" FontSize="13" FontWeight="Bold"
                                    Background="#0984E3" Foreground="White"
                                    Click="Button_Click"/>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="🔍 Auditoría de Existencias y Catálogo" FontSize="16" FontWeight="Bold" Foreground="#2D3436" Grid.Row="0"/>

                        <TextBlock x:Name="lblTotalInventario"
                                   Grid.Row="1"
                                   Text="Valor de Inventario: $0.00"
                                   FontSize="14" FontWeight="Bold"
                                   Foreground="#57606F"
                                   Margin="0,8,0,8" />

                        <ListBox x:Name="lstProductosAdmin"
                                 Grid.Row="2"
                                 Margin="0,0,0,15"
                                 BorderBrush="#DFE6E9"
                                 BorderThickness="1" />

                        <StackPanel Grid.Row="3" Orientation="Horizontal">
                            <Button x:Name="btnRestarStock"
                                    Content="➖ Restar 1 Unidad (Merma)"
                                    Width="200" Height="38"
                                    Background="#E67E22" Foreground="White"
                                    FontWeight="SemiBold" Margin="0,0,12,0"
                                    Click="btnRestarStock_Click" />

                            <Button x:Name="btnEliminar"
                                    Content="🗑 Eliminar del Catálogo"
                                    Width="200" Height="38"
                                    Background="#D63031" Foreground="White"
                                    FontWeight="SemiBold"
                                    Click="btnEliminar_Click" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>