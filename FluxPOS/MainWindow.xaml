<Window x:Class="FluxPOS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FluxPOS"
        mc:Ignorable="d"
        Title="FluxPOS - Terminal de Ventas" Height="500" Width="950">

    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F5F7FA" Offset="0.0" />
            <GradientStop Color="#C3CFE2" Offset="1.0" />
        </LinearGradientBrush>
    </Window.Background>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.2*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Grid.Column="0" Margin="15,10,15,5">
            <TextBlock Text="Nombre del Producto:" FontWeight="SemiBold" Foreground="#2D3436" Margin="0,0,0,5"/>
            <TextBox x:Name="txtNombre" Height="30" VerticalContentAlignment="Center" Padding="5,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.Column="0" Margin="15,5,15,5">
            <TextBlock Text="Precio:" FontWeight="SemiBold" Foreground="#2D3436" Margin="0,0,0,5"/>
            <TextBox x:Name="txtPrecio" Height="30" VerticalContentAlignment="Center" Padding="5,0"/>
        </StackPanel>

        <Grid Grid.Row="2" Grid.Column="0" Margin="15,10,15,15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Button Content="✚ Agregar al Inventario"
                    Width="200" Height="40"
                    FontSize="14" FontWeight="Bold"
                    Background="#0984E3" Foreground="White"
                    HorizontalAlignment="Left"
                    Click="Button_Click"/>

            <ListBox x:Name="lstProductos"
                     Grid.Row="1"
                     Margin="0,15,0,15"
                     BorderBrush="#DFE6E9"
                     BorderThickness="1"
                     MouseDoubleClick="lstProductos_MouseDoubleClick" />

            <Button x:Name="btnEliminar"
                    Grid.Row="2"
                    Content="🗑 Eliminar Seleccionado"
                    Width="180" Height="35"
                    Background="#D63031" Foreground="White"
                    HorizontalAlignment="Left"
                    FontWeight="SemiBold"
                    Click="btnEliminar_Click"/>
            
            <TextBlock x:Name="lblTotalInventario"
                       Grid.Row="2" Grid.Column="0"
                       Text="Valor de Inventario: $0.00"
                       FontSize="15" FontWeight="SemiBold"
                       Foreground="#57606F"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Bottom"
                       Margin="0,0,10,14"
                
                />
        </Grid>

        <Border Grid.Column="1" Grid.RowSpan="3" 
                Background="WhiteSmoke" 
                BorderBrush="#B2BEC3" 
                BorderThickness="2,0,0,0"
                CornerRadius="10,0,0,10">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="🛒 Carrito de Venta"
                           FontSize="22" FontWeight="Bold"
                           Foreground="#2D3436"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,15"/>

                <ListBox x:Name="lstCarrito" 
                         Grid.Row="1"
                         BorderBrush="#DFE6E9"
                         Background="White"
                         Margin="0,5"/>

                <StackPanel Grid.Row="2" Margin="0,15,0,0">
                    <Separator Background="#DFE6E9" Margin="0,0,0,10"/>
                    <TextBlock x:Name="lblTotal"
                               Text="Total: $0.00"
                               FontSize="26" FontWeight="ExtraBold"
                               Foreground="#27AE60"
                               HorizontalAlignment="Right"
                               Margin="0,0,0,15" />

                    <Button x:Name="btnFinalizarCompra"
                            Content="✔ FINALIZAR VENTA"
                            Height="55"
                            Background="#2ECC71" Foreground="White"
                            FontSize="18" FontWeight="Black"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>